" Enhanced Vim Markdown Setup
" Same as the basic setup, plus fzf-powered fuzzy file finding and a
" fuzzy-browse "save as", requested after trying those two features in the
" full-feature Neovim setup and wanting them without the rest of its weight.
" Source this from your ~/.vimrc with:
"   source /home/ed/MEGA/app/vim_for_markdown/03_vim_enhanced/vimrc
" or symlink it as ~/.vimrc directly.

" --- Clipboard ----------------------------------------------------------
" Use the system clipboard for all yank/delete/paste operations by default.
set clipboard=unnamedplus

" --- Line numbers ---------------------------------------------------------
" Relative numbers (distance from cursor) plus the actual number on the
" current line, so counted motions like 5dd/3j are easy to read off.
set number relativenumber
" 'cursorline' is what makes Vim use the CursorLineNr highlight group for
" the current line's number at all (without it, CursorLineNr is defined but
" never applied) — see the LineNr/CursorLineNr colours set per-theme below.
" cursorlineopt=number restricts the "current line" highlight to the number
" column only, so the text line itself isn't tinted.
set cursorline
set cursorlineopt=number

" --- Cursor shape + colour (terminal) --------------------------------------
" Block shape in every mode, but blinking in Insert/Replace and steady in
" Normal/Visual/Command-line — plus an orange cursor colour throughout.
" guicursor drives shape+blink in GUI Vim; t_SI/t_EI/t_SR send the DECSCUSR
" escape codes terminal Vim needs for the same effect (some xterm-256color
" terminfo entries don't wire up guicursor to the terminal on their own, so
" these are set explicitly rather than relied on). The leading OSC 12
" sequence in each sets the terminal's cursor colour (not covered by
" DECSCUSR, and not the same as the 'Cursor' highlight group below, which
" only affects GUI Vim's own cursor).
set guicursor=n-v-c-sm:block-blinkon0,i-ci-ve:block-blinkwait10-blinkon250-blinkoff250,r-cr-o:block-blinkon0
if !has('gui_running')
  let s:cursor_orange = "\<Esc>]12;#ffa500\x07"
  let &t_SI = s:cursor_orange . "\<Esc>[1 q"  " Insert: blinking block
  let &t_SR = s:cursor_orange . "\<Esc>[1 q"  " Replace: blinking block
  let &t_EI = s:cursor_orange . "\<Esc>[2 q"  " Normal/other: steady block
endif

" --- Markdown ---------------------------------------------------------
filetype plugin indent on
syntax on
if has('termguicolors')
  set termguicolors
endif

" Resolved directory this vimrc actually lives in. Plain expand('<sfile>:p:h')
" would instead give the directory of ~/.vimrc *itself* when it's a symlink
" (e.g. ~/, not this project folder) — resolve() follows the symlink first
" so paths below land inside the synced project regardless of how vimrc was
" loaded (verified: without resolve(), this silently pointed at $HOME).
let s:project_dir = fnamemodify(resolve(expand('<sfile>:p')), ':h')

" Personal dictionary (zg/zw) lives inside this synced project instead of
" the default ~/.vim/spell/en.utf-8.add, so words you add on one machine
" show up on every other machine this vimrc is symlinked on (unlike the
" theme state file below, which is deliberately per-machine). To go back to
" Vim's default (local-only, not synced), delete the "spellfile=..." part
" of the autocmd below.
let s:spellfile = s:project_dir . '/spell/en.utf-8.add'
call mkdir(fnamemodify(s:spellfile, ':h'), 'p')

" 80-character line width: textwidth makes Vim insert a real line break as
" you type past column 80 (gq/gqap reflows a paragraph that's already there,
" e.g. pasted text); colorcolumn draws a guide line at column 81 (one past
" the limit, so it doesn't sit on top of a character at column 80 itself),
" coloured dark red per-theme below.
augroup markdown_setup
  autocmd!
  execute 'autocmd FileType markdown setlocal wrap linebreak spell spelllang=en_gb spellfile=' . s:spellfile . ' textwidth=80 colorcolumn=81'
  autocmd BufNewFile,BufRead *.md,*.markdown setlocal filetype=markdown
augroup END

" --- Spell-check --------------------------------------------------------
" Toggle spell-check with <leader>s (leader defaults to \)
nnoremap <leader>s :set spell!<CR>

" --- Fix stale terminal redraw glitches -----------------------------------
" Some terminals (seen with gnome-terminal/VTE) occasionally leave stray
" coloured cells on screen after fast redraws (e.g. spell-check highlighting)
" that :redraw!/Ctrl-L doesn't clear, but resizing the window does. This
" sends the same "resize" escape sequence the window manager would (shrink
" by one column, then straight back), forcing a full repaint without
" actually changing your terminal's size. Mapped to <leader>r.
function! RefreshTerminal()
  let l:lines = &lines
  let l:columns = &columns
  call system('printf "\e[8;' . l:lines . ';' . (l:columns - 1) . 't" > /dev/tty')
  sleep 100m
  call system('printf "\e[8;' . l:lines . ';' . l:columns . 't" > /dev/tty')
endfunction
command! RefreshTerminal call RefreshTerminal()
nnoremap <leader>r :RefreshTerminal<CR>

" --- Reflow to 80 columns -------------------------------------------------
" textwidth only wraps text as you actively type it; it does nothing to text
" that's already in the buffer (an existing file, or anything pasted in).
" These reflow it on demand, inserting real line breaks at column 80.
nnoremap <leader>q gqap
nnoremap <leader>80 gggqG

" Toggle the 80-column limit itself on/off with <leader>w (does not undo any
" reflowing already done — that's just u like any other edit).
function! ToggleWrapLimit()
  if &l:textwidth == 80
    setlocal textwidth=0 colorcolumn=
    echo '80-column limit: off'
  else
    setlocal textwidth=80 colorcolumn=81
    echo '80-column limit: on'
  endif
endfunction
command! ToggleWrapLimit call ToggleWrapLimit()
nnoremap <leader>w :call ToggleWrapLimit()<CR>

" --- Insert a table skeleton ------------------------------------------------
" Drops in a simple 2-column, header + 2-data-row markdown table below the
" current line, cursor left on "h1" ready to type over the placeholders
" (gt/2gt-style navigation isn't needed for something this small — * or
" ciw/w works fine to hop between cells). Mapped to <leader>t.
function! MarkdownInsertTable()
  call append(line('.'), [
        \ '| h1 | h2 |',
        \ '| --- | --- |',
        \ '| d1r1 | d2r1 |',
        \ '| d1r2 | d2r2 |',
        \ ])
  call cursor(line('.') + 1, 3)
endfunction
command! MarkdownInsertTable call MarkdownInsertTable()
nnoremap <leader>t :call MarkdownInsertTable()<CR>

" --- Fuzzy file finder + fuzzy "save as" (fzf) -----------------------------
" fzf ships its own Vim plugin (:FZF command, fzf#run() function) right
" alongside the CLI binary — no plugin manager or extra vim plugin needed,
" just point Vim's runtimepath at wherever the fzf package installed it.
" Requires the `fzf` package (see README/setup.sh); if it's missing,
" <leader>ff and <leader>sa print a message instead of erroring.
for s:fzf_dir in [
      \ '/usr/share/doc/fzf/examples',
      \ expand('~/.fzf'),
      \ '/usr/local/opt/fzf',
      \ '/opt/homebrew/opt/fzf',
      \ ]
  if filereadable(s:fzf_dir . '/plugin/fzf.vim')
    execute 'set rtp+=' . fnameescape(s:fzf_dir)
    break
  endif
endfor
unlet! s:fzf_dir

" Fuzzy-find and open a file ("an easy way to open files, navigate to a
" file and open it") — mapped to <leader>ff to match the full-feature
" Neovim setup's Telescope binding.
function! MarkdownFuzzyFind()
  if !exists(':FZF')
    echo 'fzf not found — install it (see README), then restart Vim'
    return
  endif
  FZF
endfunction
command! MarkdownFuzzyFind call MarkdownFuzzyFind()
nnoremap <leader>ff :MarkdownFuzzyFind<CR>

" Save as, but browse to the target folder with fzf instead of typing/
" tab-completing the whole path — mirrors the full-feature Neovim setup's
" telescope-file-browser-based <leader>sa. Browse (fuzzy-filter as you
" type), Enter to pick a folder, then a small prompt (pre-filled with the
" current filename) for the final name before saving.
function! s:MarkdownSaveAsInDir(bufnr, original_name, selected)
  let l:dir = substitute(fnamemodify(a:selected, ':p'), '/$', '', '')
  let l:target = input('Save as: ', l:dir . '/' . a:original_name, 'file')
  if !empty(l:target)
    let l:winid = bufwinid(a:bufnr)
    if l:winid != -1
      call win_gotoid(l:winid)
    endif
    execute 'saveas ' . fnameescape(l:target)
  endif
endfunction

function! MarkdownSaveAs()
  if !exists('*fzf#run')
    echo 'fzf not found — install it (see README), then restart Vim'
    return
  endif
  let l:bufnr = bufnr('%')
  let l:original_name = expand('%:t')
  call fzf#run(fzf#wrap({
        \ 'source': 'find . -type d',
        \ 'dir': expand('%:p:h'),
        \ 'sink': function('s:MarkdownSaveAsInDir', [l:bufnr, l:original_name]),
        \ 'options': ['--prompt', 'Save in> '],
        \ }))
endfunction
command! MarkdownSaveAs call MarkdownSaveAs()
nnoremap <leader>sa :MarkdownSaveAs<CR>

" --- Markdown syntax highlighting (light/dark) ---------------------------
" Colors real markdown elements: headings, bold/italic, bullets, links,
" code, blockquotes, horizontal rules. Uses Vim's actual built-in markdown
" syntax group names (see :help ft-markdown-syntax) — a from-scratch,
" corrected/extended version of an older colour scheme (Notepad++-style
" light theme), plus a matching dark theme. Toggle with <leader>d.

function! s:LightMarkdownTheme()
  set background=light
  colorscheme default
  hi Normal       guibg=#ffffff guifg=#000000 ctermbg=White ctermfg=Black
  hi CursorLine   guibg=#f0f0f0 ctermbg=254 cterm=NONE gui=NONE
  hi LineNr       guibg=#0000af guifg=#ffff00 ctermbg=DarkBlue ctermfg=Yellow
  hi CursorLineNr guibg=#32cd32 guifg=#ff0000 gui=bold ctermbg=Green ctermfg=Red cterm=bold
  hi StatusLine   guibg=#d0d0d0 guifg=#000000 ctermbg=252 ctermfg=Black
  hi StatusLineNC guibg=#e0e0e0 guifg=#606060 ctermbg=254 ctermfg=244
  hi Cursor       guibg=#ffa500 guifg=bg

  " Headings: bold red, delimiter (#) slightly muted red
  hi markdownH1 guifg=#c00000 gui=bold ctermfg=Red cterm=bold
  hi markdownH2 guifg=#c00000 gui=bold ctermfg=Red cterm=bold
  hi markdownH3 guifg=#c00000 gui=bold ctermfg=Red cterm=bold
  hi markdownH4 guifg=#c00000 gui=bold ctermfg=Red cterm=bold
  hi markdownH5 guifg=#c00000 gui=bold ctermfg=Red cterm=bold
  hi markdownH6 guifg=#c00000 gui=bold ctermfg=Red cterm=bold
  hi markdownHeadingDelimiter guifg=#a00000 gui=bold ctermfg=DarkRed cterm=bold

  " Emphasis
  hi markdownBold       guifg=#0000ff gui=bold ctermfg=Blue cterm=bold
  hi markdownItalic     guifg=#7f0055 gui=italic ctermfg=Magenta cterm=italic
  hi markdownBoldItalic guifg=#0000ff gui=bold,italic ctermfg=Blue cterm=bold,italic
  hi markdownStrike     guifg=#808080 gui=strikethrough ctermfg=Gray cterm=strikethrough

  " Lists and quotes
  hi markdownListMarker guifg=#d2691e gui=bold ctermfg=DarkYellow cterm=bold
  hi markdownBlockquote guifg=#008000 gui=italic ctermfg=DarkGreen cterm=italic
  hi markdownRule        guifg=#800080 gui=bold ctermfg=Magenta cterm=bold

  " Links
  hi markdownLinkText      guifg=#0000ee gui=underline ctermfg=Blue cterm=underline
  hi markdownUrl           guifg=#008080 ctermfg=Cyan
  hi markdownLinkDelimiter guifg=#808080 ctermfg=Gray
  hi markdownUrlDelimiter  guifg=#808080 ctermfg=Gray

  " Inline/fenced code: dark green text on a light grey box
  hi markdownCode          guifg=#006400 guibg=#f5f5f5 ctermfg=22 ctermbg=254
  hi markdownCodeBlock     guifg=#006400 guibg=#f5f5f5 ctermfg=22 ctermbg=254
  hi markdownCodeDelimiter guifg=#808080 ctermfg=Gray

  " Spell-check: underline only, text colour forced to match Normal so
  " flagged words (e.g. brand names/proper nouns not in the dictionary,
  " like "LENOVO") never lose contrast to Vim's default spell colours
  " (which include a background fill on some terminals).
  hi SpellBad   guifg=#000000 guibg=NONE gui=undercurl guisp=#c00000 ctermfg=Black ctermbg=NONE cterm=underline
  hi SpellCap   guifg=#000000 guibg=NONE gui=undercurl guisp=#0000ff ctermfg=Black ctermbg=NONE cterm=underline
  hi SpellRare  guifg=#000000 guibg=NONE gui=undercurl guisp=#800080 ctermfg=Black ctermbg=NONE cterm=underline
  hi SpellLocal guifg=#000000 guibg=NONE gui=undercurl guisp=#008080 ctermfg=Black ctermbg=NONE cterm=underline

  " Guide line at column 81 (see textwidth/colorcolumn above). A single
  " character cell is the thinnest line the terminal can draw; dark red
  " here keeps it less visually loud than a full-brightness red.
  hi ColorColumn guibg=#8b0000 ctermbg=DarkRed

  let g:markdown_theme = 'light'
endfunction

function! s:DarkMarkdownTheme()
  set background=dark
  colorscheme default
  hi Normal       guibg=#1e1e1e guifg=#d4d4d4 ctermbg=Black ctermfg=White
  hi CursorLine   guibg=#2a2a2a ctermbg=235 cterm=NONE gui=NONE
  hi LineNr       guibg=#0000af guifg=#ffff00 ctermbg=DarkBlue ctermfg=Yellow
  hi CursorLineNr guibg=#32cd32 guifg=#ff0000 gui=bold ctermbg=Green ctermfg=Red cterm=bold
  hi StatusLine   guibg=#3a3a3a guifg=#d4d4d4 ctermbg=238 ctermfg=White
  hi StatusLineNC guibg=#2a2a2a guifg=#808080 ctermbg=235 ctermfg=244
  hi Cursor       guibg=#ffa500 guifg=bg

  " Headings: bold light red/orange, delimiter muted
  hi markdownH1 guifg=#ff6b6b gui=bold ctermfg=LightRed cterm=bold
  hi markdownH2 guifg=#ff6b6b gui=bold ctermfg=LightRed cterm=bold
  hi markdownH3 guifg=#ff6b6b gui=bold ctermfg=LightRed cterm=bold
  hi markdownH4 guifg=#ff6b6b gui=bold ctermfg=LightRed cterm=bold
  hi markdownH5 guifg=#ff6b6b gui=bold ctermfg=LightRed cterm=bold
  hi markdownH6 guifg=#ff6b6b gui=bold ctermfg=LightRed cterm=bold
  hi markdownHeadingDelimiter guifg=#b05050 gui=bold ctermfg=DarkRed cterm=bold

  " Emphasis
  hi markdownBold       guifg=#6ab0ff gui=bold ctermfg=LightBlue cterm=bold
  hi markdownItalic     guifg=#d18fd1 gui=italic ctermfg=LightMagenta cterm=italic
  hi markdownBoldItalic guifg=#6ab0ff gui=bold,italic ctermfg=LightBlue cterm=bold,italic
  hi markdownStrike     guifg=#808080 gui=strikethrough ctermfg=Gray cterm=strikethrough

  " Lists and quotes
  hi markdownListMarker guifg=#e5a05a gui=bold ctermfg=Yellow cterm=bold
  hi markdownBlockquote guifg=#6a9955 gui=italic ctermfg=Green cterm=italic
  hi markdownRule        guifg=#c586c0 gui=bold ctermfg=LightMagenta cterm=bold

  " Links
  hi markdownLinkText      guifg=#569cd6 gui=underline ctermfg=LightBlue cterm=underline
  hi markdownUrl           guifg=#4ec9b0 ctermfg=Cyan
  hi markdownLinkDelimiter guifg=#808080 ctermfg=Gray
  hi markdownUrlDelimiter  guifg=#808080 ctermfg=Gray

  " Inline/fenced code: light green text on a dark grey box
  hi markdownCode          guifg=#7ec699 guibg=#2d2d2d ctermfg=Green ctermbg=235
  hi markdownCodeBlock     guifg=#7ec699 guibg=#2d2d2d ctermfg=Green ctermbg=235
  hi markdownCodeDelimiter guifg=#808080 ctermfg=Gray

  " Spell-check: underline only, text colour forced to match Normal so
  " flagged words (e.g. brand names/proper nouns not in the dictionary,
  " like "LENOVO") never lose contrast to Vim's default spell colours
  " (which include a background fill on some terminals).
  hi SpellBad   guifg=#d4d4d4 guibg=NONE gui=undercurl guisp=#ff6b6b ctermfg=White ctermbg=NONE cterm=underline
  hi SpellCap   guifg=#d4d4d4 guibg=NONE gui=undercurl guisp=#6ab0ff ctermfg=White ctermbg=NONE cterm=underline
  hi SpellRare  guifg=#d4d4d4 guibg=NONE gui=undercurl guisp=#c586c0 ctermfg=White ctermbg=NONE cterm=underline
  hi SpellLocal guifg=#d4d4d4 guibg=NONE gui=undercurl guisp=#4ec9b0 ctermfg=White ctermbg=NONE cterm=underline

  " Guide line at column 81 (see textwidth/colorcolumn above). A single
  " character cell is the thinnest line the terminal can draw; dark red
  " here keeps it less visually loud than a full-brightness red.
  hi ColorColumn guibg=#8b0000 ctermbg=DarkRed

  let g:markdown_theme = 'dark'
endfunction

function! s:ApplyCurrentTheme()
  if get(g:, 'markdown_theme', 'light') ==# 'dark'
    call s:DarkMarkdownTheme()
  else
    call s:LightMarkdownTheme()
  endif
endfunction

" --- Theme persistence ----------------------------------------------------
" g:markdown_theme only lives in memory for the current session by default,
" so the light/dark choice would silently reset to light every time Vim is
" reopened. Persist it to a small state file instead (mirrors where Vim/
" Neovim already keep their own state, e.g. swap files under
" ~/.local/state/) so <leader>d survives quitting and reopening Vim.
let s:theme_state_file = expand('~/.local/state/vim_enhanced_markdown_theme')

function! s:LoadSavedTheme()
  if filereadable(s:theme_state_file)
    return (get(readfile(s:theme_state_file), 0, 'light') ==# 'dark') ? 'dark' : 'light'
  endif
  return 'light'
endfunction

function! s:SaveTheme(theme)
  try
    call mkdir(fnamemodify(s:theme_state_file, ':h'), 'p')
    call writefile([a:theme], s:theme_state_file)
  catch
    " Non-fatal: worst case the preference just doesn't persist this time.
  endtry
endfunction

function! MarkdownThemeToggle()
  let g:markdown_theme = (get(g:, 'markdown_theme', 'light') ==# 'light') ? 'dark' : 'light'
  call s:ApplyCurrentTheme()
  call s:SaveTheme(g:markdown_theme)
  echo 'Markdown theme: ' . g:markdown_theme
endfunction
command! MarkdownThemeToggle call MarkdownThemeToggle()
nnoremap <leader>d :MarkdownThemeToggle<CR>

" Vim's own markdown syntax file defines default highlight links (e.g.
" "hi def link markdownH1 htmlH1") the moment syntax is loaded for a
" markdown buffer. Those defaults would silently win over colours set any
" earlier, so re-apply our theme's markdown-specific groups on the Syntax
" event, which fires right after that file finishes loading.
augroup markdown_theme
  autocmd!
  autocmd Syntax markdown call s:ApplyCurrentTheme()
augroup END

let g:markdown_theme = s:LoadSavedTheme()
call s:ApplyCurrentTheme()

" --- Preview to browser -------------------------------------------------
" Renders the current markdown file to HTML (via pandoc) and opens it
" in the default browser. Mapped to <leader>p in normal mode.
" Written to /tmp (not next to the source file) since this is a disposable
" render, not an export the user wants to keep around in their notes.
function! MarkdownPreview()
  if &filetype != 'markdown'
    echo "Not a markdown file"
    return
  endif
  if empty(expand('%:p'))
    echo "Save the file first (:w) before previewing"
    return
  endif
  if &modified
    write
  endif
  let l:src = expand('%:p')
  let l:out = '/tmp/' . expand('%:t:r') . '_preview.html'
  let l:result = system('pandoc -f markdown-yaml_metadata_block ' . shellescape(l:src) . ' -s -o ' . shellescape(l:out))
  if v:shell_error != 0
    echo "Preview failed: " . l:result
    return
  endif
  call system('xdg-open ' . shellescape(l:out) . ' &')
endfunction
command! MarkdownPreview call MarkdownPreview()
nnoremap <leader>p :MarkdownPreview<CR>

" --- Export to PDF --------------------------------------------------------
" Exports the current markdown file to PDF (via pandoc + wkhtmltopdf).
" Mapped to <leader>e in normal mode.
function! MarkdownExportPdf()
  if &filetype != 'markdown'
    echo "Not a markdown file"
    return
  endif
  let l:src = expand('%:p')
  let l:out = expand('%:p:r') . '.pdf'
  let l:result = system('pandoc -f markdown-yaml_metadata_block ' . shellescape(l:src) . ' --pdf-engine=wkhtmltopdf -o ' . shellescape(l:out))
  if v:shell_error != 0
    echo "PDF export failed: " . l:result
  else
    echo "Exported to " . l:out
  endif
endfunction
command! MarkdownExportPdf call MarkdownExportPdf()
nnoremap <leader>e :MarkdownExportPdf<CR>

" --- Shortcut help ---------------------------------------------------------
" Opens the bundled shortcut reference (vim_shortcuts.md) in a split, the
" same way Vim's own :help does — so :q closes just that split and drops you
" back on whatever you had open, instead of replacing your only window
" (which would make :q close Vim itself). Mapped to <leader>h in normal
" mode. (vim_shortcuts.html is still there too, for a full searchable
" browser reference — preview this .md with <leader>p for an HTML render.)
let s:shortcuts_md = s:project_dir . '/vim_shortcuts.md'
function! MarkdownHelp()
  execute 'split ' . fnameescape(s:shortcuts_md)
endfunction
command! MarkdownHelp call MarkdownHelp()
nnoremap <leader>h :MarkdownHelp<CR>
